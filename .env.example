# Copy this file to .env and fill in what you need.
# Nothing here is a real secret — these are placeholders.

# Required for signing dashboard login tokens. Generate a real one with:
#   openssl rand -hex 32
SECRET_KEY=replace-me-with-openssl-rand-hex-32

# Database
# Dev default — file-based, no setup needed:
DATABASE_URL=sqlite+aiosqlite:///./luminal.db
# Prod (Postgres) — plain postgres:// or postgresql:// URLs work fine,
# Luminal rewrites them to use the async driver automatically:
# DATABASE_URL=postgresql://user:pass@host:5432/luminal

# Redis (optional — enables response caching and rate limiting)
# REDIS_URL=redis://localhost:6379/0

# RAG / vector store (optional — only needed for document upload + RAG)
# VECTOR_STORE=chroma          # chroma | pinecone | weaviate
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# PINECONE_API_KEY=
# PINECONE_INDEX=

# Provider keys — add at least one so /route has something to call.
# Ollama needs no key at all, just `ollama serve` running locally.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# NVIDIA_API_KEY=
# MISTRAL_API_KEY=
# GEMINI_API_KEY=
DEFAULT_PROVIDER=ollama

# App
APP_ENV=development            # development | production
DEBUG=true                     # set to false in production
ALLOWED_ORIGINS=http://localhost:3000
